<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pad_drum_active" />
            <corners android:radius="6dp" />
            <stroke android:width="2dp" android:color="#6BB5FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pad_drum_default" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#2A5580" />
        </shape>
    </item>
</selector>
