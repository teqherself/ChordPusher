<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pad_note_on" />
            <corners android:radius="6dp" />
            <stroke android:width="2dp" android:color="@color/accent_red" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pad_default" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#3D3D6E" />
        </shape>
    </item>
</selector>
