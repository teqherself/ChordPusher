<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MIDI Settings"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- MIDI output channel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chord MIDI Channel"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnChordChannelMinus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="-"
                android:textSize="16sp"
                android:background="@drawable/pad_chord"
                android:textColor="@color/text_primary"
                android:padding="0dp" />

            <TextView
                android:id="@+id/tvChordChannel"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="@color/accent_red"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center" />

            <Button
                android:id="@+id/btnChordChannelPlus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="+"
                android:textSize="16sp"
                android:background="@drawable/pad_chord"
                android:textColor="@color/text_primary"
                android:padding="0dp" />

        </LinearLayout>

        <!-- Drum MIDI channel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Drum MIDI Channel"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnDrumChannelMinus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="-"
                android:textSize="16sp"
                android:background="@drawable/pad_drum"
                android:textColor="@color/text_primary"
                android:padding="0dp" />

            <TextView
                android:id="@+id/tvDrumChannelSettings"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="10"
                android:textColor="@color/pad_drum_active"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center" />

            <Button
                android:id="@+id/btnDrumChannelPlus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="+"
                android:textSize="16sp"
                android:background="@drawable/pad_drum"
                android:textColor="@color/text_primary"
                android:padding="0dp" />

        </LinearLayout>

        <!-- Connected device info -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connected Device"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDeviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No device connected"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:background="@color/bg_panel"
            android:padding="12dp" />

    </LinearLayout>

</ScrollView>
