<?xml version="1.0" encoding="utf-8"?>
<!--
  Drum Rack Panel
  4x4 pad grid matching Ableton Drum Rack layout
  MIDI notes: bottom-left = 36 (C1 = kick), ascending right then up
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg_dark"
    android:padding="8dp">

    <!-- Left sidebar: drum channel info -->
    <LinearLayout
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/bg_panel"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DRUM\nRACK"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bg_dark"
            android:layout_marginVertical="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/channel_label"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvDrumChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="10"
            android:textColor="@color/pad_drum_active"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginVertical="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bg_dark"
            android:layout_marginVertical="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/velocity_label"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvDrumVelocity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="100"
            android:textColor="@color/pad_drum_active"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginVertical="4dp" />

        <SeekBar
            android:id="@+id/seekDrumVelocity"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:max="127"
            android:progress="100"
            android:rotation="270" />

    </LinearLayout>

    <!-- Drum pad grid: 4x4 -->
    <GridLayout
        android:id="@+id/drumGrid"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:columnCount="4"
        android:rowCount="4"
        android:layout_marginStart="8dp"
        android:useDefaultMargins="false">

        <!-- Pads are added programmatically by MainActivity -->

    </GridLayout>

</LinearLayout>
